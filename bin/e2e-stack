#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/ports.sh
source "$repo_dir/bin/lib/ports.sh"

export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-mi_precio_e2e}"
if [[ "${E2E_PORTS_SELECTED:-false}" != true ]]; then
  reserve_available_port E2E_WEB_PORT "${E2E_WEB_PORT:-43117}" "E2E web app"
  reserve_available_port E2E_API_PORT "${E2E_API_PORT:-43118}" "E2E API"
  reserve_available_port E2E_STORAGE_PORT "${E2E_STORAGE_PORT:-43119}" "E2E MinIO API"
  reserve_available_port E2E_STORAGE_CONSOLE_PORT "${E2E_STORAGE_CONSOLE_PORT:-43120}" "E2E MinIO console"
fi
export API_PORT="$E2E_API_PORT"
export WEB_APP_PORT="$E2E_WEB_PORT"
export STORAGE_PORT="$E2E_STORAGE_PORT"
export STORAGE_CONSOLE_PORT="$E2E_STORAGE_CONSOLE_PORT"
export STORAGE_PUBLIC_URL="http://localhost:$E2E_STORAGE_PORT"

cd "$repo_dir"

cleanup() {
  docker compose -f compose.yaml -f compose.e2e.yaml down --volumes --remove-orphans
}
cleanup
docker compose -f compose.yaml -f compose.e2e.yaml up --detach --build --force-recreate
docker compose -f compose.yaml -f compose.e2e.yaml logs --follow
