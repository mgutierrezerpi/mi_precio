          "name": "Essay Side Caption One",
          "fill": "#70583F",
          "textGrowth": "fixed-width",
          "width": 216,
          "content": "A WEDGE OF ALPINE GRUYÈRE, WAITING FOR THE KNIFE.",
          "lineHeight": 1.3,
          "fontFamily": "IBM Plex Mono",
          "fontSize": 8,
          "fontWeight": "normal",
          "letterSpacing": 0.5
        },
