          "x": 46,
          "y": 38,
          "name": "Essay Folio",
          "fill": "#8A5A30",
          "content": "09 · NOTES FROM THE COUNTER",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 10,
          "fontWeight": "normal",
          "letterSpacing": 1.1
        },
        {
          "type": "frame",
          "id": "g5ngb",
          "x": 46,
          "y": 68,
          "name": "Essay Top Image",
          "clip": true,
          "width": 608,
