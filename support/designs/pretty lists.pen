          "name": "Essay Folio",
          "fill": "#8A5A30",
          "content": "08 · NOTES FROM THE MARKET",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 10,
          "fontWeight": "normal",
          "letterSpacing": 1.1
        },
        {
          "type": "frame",
          "id": "LKaLB",
          "x": 46,
          "y": 68,
          "name": "Essay Top Image",
          "clip": true,
          "width": 300,
          "height": 156,
          "fill": {
            "type": "image",
            "enabled": true,
            "url": "images/generated-1786197239827.png",
            "mode": "fill"
          },
          "layout": "none"
        },
        {
          "type": "text",
          "id": "mmeGW",
          "x": 46,
          "y": 236,
          "name": "Essay Top Caption",
          "fill": "#70583F",
          "content": "LUNCH, BEFORE THE FIRST GUEST ARRIVES",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 8,
          "fontWeight": "normal",
          "letterSpacing": 0.7
        },
        {
          "type": "text",
          "id": "yfbfL",
          "x": 46,
          "y": 276,
          "name": "Essay Title",
          "fill": "#3A2A1D",
          "textGrowth": "fixed-width",
          "width": 470,
          "content": "Why flowers change a room.",
          "lineHeight": 1,
          "fontFamily": "Playfair Display",
          "fontSize": 44,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "DUQxm",
          "x": 46,
          "y": 380,
          "name": "Essay Standfirst",
          "fill": "#8A5A30",
          "textGrowth": "fixed-width",
          "width": 410,
          "content": "A bunch of flowers is never only decorative. It is a small shift in attention.",
          "lineHeight": 1.2,
          "fontFamily": "Playfair Display",
          "fontSize": 20,
          "fontWeight": "normal",
          "fontStyle": "italic"
        },
        {
          "type": "text",
          "id": "e3KdJm",
          "x": 46,
          "y": 452,
          "name": "Essay Byline",
          "fill": "#70583F",
          "content": "WORDS BY LENA MORROW · WILD STEM JOURNAL",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 8,
          "fontWeight": "normal",
          "letterSpacing": 0.6
        },
        {
          "type": "text",
          "id": "mSBXx",
          "x": 46,
          "y": 496,
          "name": "Essay Body",
          "fill": "#4E4038",
          "textGrowth": "fixed-width",
          "width": 355,
          "content": "There are days when a room asks for very little. A window opened to the afternoon, a clean table, a glass of water. Then a few stems arrive, and the whole place begins to feel more awake.\n\nAt the market, we choose flowers for this exact reason. Not because every bunch needs to be grand, but because a colour, a curve, or a little scent can change the pace of an ordinary hour.\n\nWe think of flowers as companions to daily life: beside the bed, near a good book, or gathered in the middle of a table that is about to welcome friends.",
          "lineHeight": 1.48,
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "B0OLv",
          "x": 438,
          "y": 500,
          "name": "Essay Side Photo One",
          "clip": true,
          "width": 216,
          "height": 162,
          "fill": {
            "type": "image",
            "enabled": true,
            "url": "images/generated-1786197239727.png",
            "mode": "fill"
          },
          "layout": "none"
        },
        {
          "type": "text",
