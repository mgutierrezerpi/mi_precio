          "fill": "#8A5A30",
          "content": "08 · THE LONG TABLE",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 10,
          "fontWeight": "normal",
          "letterSpacing": 1.1
        },
        {
          "type": "frame",
          "id": "kofq2",
