    {
      "type": "frame",
      "id": "U2tIm",
      "x": 15100,
      "y": 5634,
      "name": "27 · The Calm Spa Journal — Long-form",
      "clip": true,
      "width": 700,
      "height": 900,
      "fill": "#FAF7F0",
      "layout": "none",
      "children": [
        {
          "type": "text",
          "id": "N1P59P",
          "x": 46,
          "y": 40,
          "name": "Story Folio",
          "fill": "#A76D3E",
          "content": "08 · A NOTE ON REST",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 10,
          "fontWeight": "normal",
          "letterSpacing": 1.1
        },
        {
          "type": "text",
          "id": "R02SX",
          "x": 46,
          "y": 78,
          "name": "Story Title",
          "fill": "#233C2C",
          "textGrowth": "fixed-width",
          "width": 590,
          "content": "The body knows before we do.",
          "lineHeight": 0.98,
          "fontFamily": "Playfair Display",
          "fontSize": 50,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "LLYnN",
          "x": 46,
          "y": 230,
          "name": "Story Standfirst",
          "fill": "#50634C",
          "textGrowth": "fixed-width",
          "width": 520,
          "content": "Three signs you are overdue for a slower hour — and what to do with it.",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "FihID",
          "x": 46,
          "y": 355,
          "name": "01 Story Number",
          "fill": "#A76D3E",
          "content": "01",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "To7fk",
          "x": 92,
          "y": 352,
          "name": "Your shoulders are still working Heading",
          "fill": "#233C2C",
          "content": "Your shoulders are still working",
          "fontFamily": "Playfair Display",
          "fontSize": 25,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "bVQDh",
          "x": 92,
          "y": 390,
          "name": "Your shoulders are still working Copy",
          "fill": "#50634C",
          "textGrowth": "fixed-width",
          "width": 500,
          "content": "If the day has ended but your body is still braced, begin with warmth. A hot towel, a quiet room, a hand on the sternum. Start where the tension is obvious.",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "A16aiq",
          "x": 46,
          "y": 495,
          "name": "02 Story Number",
          "fill": "#A76D3E",
          "content": "02",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "F7u4Ld",
          "x": 92,
          "y": 492,
          "name": "You have forgotten the shape of silence Heading",
          "fill": "#233C2C",
          "content": "You have forgotten the shape of silence",
          "fontFamily": "Playfair Display",
          "fontSize": 25,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "GAvyN",
          "x": 92,
          "y": 530,
          "name": "You have forgotten the shape of silence Copy",
          "fill": "#50634C",
          "textGrowth": "fixed-width",
          "width": 500,
          "content": "Silence does not arrive by accident. It needs a doorway: a phone left behind, a light turned down, a breath that is allowed to finish.",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "b4Un8",
          "x": 46,
          "y": 635,
          "name": "03 Story Number",
          "fill": "#A76D3E",
          "content": "03",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "OlhGt",
          "x": 92,
          "y": 632,
          "name": "You are waiting to deserve it Heading",
          "fill": "#233C2C",
          "content": "You are waiting to deserve it",
          "fontFamily": "Playfair Display",
          "fontSize": 25,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "cziUV",
          "x": 92,
          "y": 670,
          "name": "You are waiting to deserve it Copy",
          "fill": "#50634C",
          "textGrowth": "fixed-width",
          "width": 500,
          "content": "Care is not a prize for completing the list. It is one of the things that lets the list become possible.",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "imPnu",
          "x": 46,
          "y": 850,
          "name": "Story Footer",
          "fill": "#63745B",
          "content": "THE CALM SPA · JOURNAL · 08",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 9,
          "fontWeight": "normal",
          "letterSpacing": 0.8
        }
      ]
    },
