#!/bin/bash
set -e

cd "$(dirname "$0")/.."

echo "Syncing development dependencies..."
PIPENV_VENV_IN_PROJECT=1 pipenv sync --dev

echo "Running linter..."
PIPENV_VENV_IN_PROJECT=1 pipenv run ruff check .

echo ""
echo "Running editor diagnostics..."
npx --yes pyright@1.1.408 --project ../pyrightconfig.json

echo ""
echo "Running static type checker..."
PIPENV_VENV_IN_PROJECT=1 pipenv run mypy .

echo ""
echo "Running tests..."
# Exit code 5 means no tests collected, which is ok
PIPENV_VENV_IN_PROJECT=1 pipenv run pytest || test $? -eq 5

echo ""
echo "All checks passed!"
